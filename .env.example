# NutriCoach AI - Variables de entorno
# Copia este archivo a `.env` y rellena con tus valores reales.
# NUNCA commitees `.env` al repositorio (ya está en `.gitignore`).

# === Supabase ===
# Estas vienen de tu proyecto en https://supabase.com/dashboard
# Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key-here

# === OpenCode Go (motor principal: DeepSeek V4.1 Flash) ===
# Suscripcion OpenCode Go: https://opencode.ai/console
# Se usa en el backend (Edge Functions) y NUNCA en el cliente iOS.
OPENCODE_GO_API_KEY=sk-...your-opencode-go-key-here
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_FALLBACK_MODEL=glm-5.3-flash
# Planes de comidas: GLM es ~4x mas rapido y cabe en el presupuesto de tiempo
OPENCODE_GO_PLAN_MODEL=glm-5.3-flash
OPENCODE_GO_PLAN_FALLBACK_MODEL=deepseek-v4.1-flash

# === Gemini 3.5 Flash (solo notas de voz y respaldo) ===
# Tu API key de https://aistudio.google.com/apikey
# Verificado 2026-10-07: ningun modelo de OpenCode Go acepta input_audio,
# asi que las notas de voz siguen procesandose con Gemini.
GEMINI_API_KEY=AIza...your-gemini-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# === Apple Developer (para build en GitHub Actions) ===
# App Store Connect API key (para descarga de provisioning profiles)
APPLE_TEAM_ID=ABCDE12345
APPLE_BUNDLE_ID=com.joelmortees.nutricoach
APPLE_KEY_ID=1234567890
APPLE_ISSUER_ID=abcdef12-3456-7890-abcd-ef1234567890
# El contenido de la clave .p8 codificado en base64
APPLE_API_KEY_BASE64=LS0tLS1CRUdJTi...base64-encoded-p8-key

# === Web search MCP (opcional) ===
# Si no lo configuras, el agente usará fallback de búsqueda.
WEB_SEARCH_MCP_ENABLED=true

# === USDA FoodData Central (opcional) ===
# https://fdc.nal.usda.gov/api-key-signup.html - gratis
USDA_FDC_API_KEY=DEMO_KEY

# === App Config ===
APP_ENV=development
LOG_LEVEL=info
